NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
GEMINI_API_KEY=your_gemini_api_key_here
N8N_INGEST_WEBHOOK_URL=your_n8n_ingest_webhook_url_here
# Must match RELAY_AUTH_SECRET in relay/.env — a long random string used to
# sign short-lived tokens for live-session WebSocket connections. Generate
# one with: openssl rand -hex 32
RELAY_AUTH_SECRET=your_shared_relay_secret_here
