DEEPGRAM_API_KEY=your_deepgram_api_key_here
PORT=3001
# Must match RELAY_AUTH_SECRET in the Next.js app's .env.local — used to
# verify the short-lived tokens the app mints for each live session.
RELAY_AUTH_SECRET=your_shared_relay_secret_here
# Optional: cap on simultaneous live (mic) connections. Defaults to 20.
RELAY_MAX_LIVE_CONNECTIONS=20
